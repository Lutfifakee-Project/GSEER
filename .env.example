# GSEER — example environment for self-hosted mode (v0.2.0).
#
# Copy to `.env` and fill in, OR let `gseer setup --with-compose` (M11)
# generate this file with a cryptographically-random password.  Never
# commit a real `.env` — the `.gitignore` excludes it.
#
# Precedence (highest wins, per SPEC-03 §5 and internal/config/loader.go):
#   CLI flags  >  environment variables (this file)  >  YAML config file  >  PD-1…PD-9 defaults
#
# Env vars set to an empty string are treated as UNSET (except
# GSEER_DB_PASSWORD where an explicitly-set empty value is meaningful
# for trust-auth dev setups).

# ─── Profile ─────────────────────────────────────────────────────────────
# client | self-hosted.  Default: client (safest —
# no PostgreSQL needed).  Switch to self-hosted for local server + search.
GSEER_PROFILE=self-hosted

# ─── PostgreSQL (OD-7: PostgreSQL 16+ enforced; Compose ships postgres:17-alpine) ─
# Loopback-only by default; docker-compose.yml binds 127.0.0.1:5432.
# `gseer setup --with-compose` generates GSEER_DB_PASSWORD with:
#   openssl rand -hex 24
# Do NOT use the placeholder below in any real deployment.
GSEER_DB_USER=gseer
GSEER_DB_PASSWORD=CHANGE_ME_generated_by_setup_with_compose
GSEER_DB_NAME=gseer
GSEER_DB_HOST=127.0.0.1
GSEER_DB_PORT=5432
# SSL mode: disable (loopback) | require | verify-ca | verify-full.
# Non-loopback deployments MUST use require or verify-full.
GSEER_DB_SSLMODE=disable

# Full DSN (overrides the component fields above when set).
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# GSEER_DB_DSN=
#
# ─── Runtime credential (v0.2.0 hardened model, M-B) ──────────────────────
# The least-privilege `gseer_app` login role, provisioned by
# `gseer setup --self-hosted` (bootstrap → migrate → grants → audit).
# The setup command PRINTS this DSN exactly once (random password);
# rotate anytime with `gseer setup --self-hosted --reset-runtime-password`.
# `gseer server start` REQUIRES it and refuses to serve traffic as any
# other role (OD-5, docs/DEPLOYMENT.md §2/§3).  Data-plane CLI commands
# (search/export/collect/suppress/source/host) prefer it and print an
# explicit notice when falling back to the operator credential.
# GSEER_DB_RUNTIME_DSN=postgres://gseer_app:<password>@127.0.0.1:5432/gseer?sslmode=disable
#
# NOTE on key names: `gseer setup --with-compose` writes the host-side
# convenience key `GSEER_DSN=` into the generated .env (consumed via
# `grep '^GSEER_DSN='` in the quickstart).  The config layer itself
# reads `GSEER_DB_DSN` (this file) — export one into the other when
# handing a session over to self-hosted mode (docs/QUICKSTART.md §4).

# Migration advisory-lock timeout (milliseconds), M3.
# How long `gseer setup --self-hosted` waits for
# the golang-migrate advisory lock before failing with
# DB_MIGRATION_LOCK_TIMEOUT (never hangs).  Range: 1000..300000.
GSEER_DB_MIGRATION_LOCK_TIMEOUT_MS=30000

# ─── Server (self-hosted profile) ────────────────────────────────────────
# Loopback bind by default.  Non-loopback (0.0.0.0, etc.) REQUIRES
# GSEER_TOKEN to be set — the config layer rejects non-loopback without
# auth (internal/config/profiles.go).
GSEER_LISTEN=127.0.0.1:8443
GSEER_LOG_LEVEL=info   # debug | info | warn | error
GSEER_LOG_FORMAT=text  # text | json

# ─── Authentication ──────────────────────────────────────────────────────
# API token for the REST API (SPEC-07 §2: Authorization: Bearer <token>).
# Hashed at rest (SHA-256) during config Load; the plaintext is cleared
# from memory after hashing (internal/config/hash.go).
# Generate with: openssl rand -hex 32
# GSEER_TOKEN=

# ─── Client profile (when GSEER_PROFILE=client) ──────────────────────────
# The remote GSEER server URL to query.  Required for the client profile;
# ignored for self-hosted.
# GSEER_CLIENT_ENDPOINT=https://gseer.example.com

# ─── Policy (QS-6) ───────────────────────────────────────────────────────
# Trusted proxies: CIDRs (or bare IPs) of reverse proxies
# in front of the server whose X-Forwarded-For header may be honored for
# client-IP resolution (rate limiting).  Empty default = X-Forwarded-For
# is IGNORED entirely — a client can never spoof its rate-limit identity
# by setting the header.  Only name proxies you actually run.
# GSEER_SERVER_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Fixture evaluation gate.  Default: false on non-dev installs.
# When false, `gseer setup --load-fixtures` is refused with a confirmation
# prompt; when true, the prompt is skipped (dev profile only).
GSEER_POLICY_EVALUATION_FIXTURES=false

# ─── Config file location ────────────────────────────────────────────────
# Default: ~/.gseer/config.yaml (Unix) or %APPDATA%\gseer\config.yaml (Win).
# Override with --config flag or GSEER_CONFIG env var.
# GSEER_CONFIG=/path/to/config.yaml

# ═══ Keys NOT accepted (AC-7.x) ══════════════════════════════════════════
# Any `policy.active.*` key is REJECTED by config validation with
# E_CONFIG_POLICY_ACTIVE_REJECTED.  Active collection (P2/PAC) is not
# part of any release until its gates close; PD-2…PD-7 are approved as
# engineering defaults only, not authorization to scan.  Passive
# collection is explicit and operator-driven: gseer source add
# → gseer source enable → gseer collect run.  The rejection is
# normative, not a missing feature.
#
# Similarly rejected:
#   - insecure_skip_verify / InsecureSkipVerify (E_CONFIG_INSECURE)
#   - Any unknown YAML key not in the documented schema (E_CONFIG_UNKNOWN_KEY)
