# GSEER .editorconfig — M1 (Phase 1, v0.0.1).
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{go,mod,sum}]
indent_style = tab
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false  # Markdown requires trailing two spaces for hard line breaks.

[Makefile]
indent_style = tab
